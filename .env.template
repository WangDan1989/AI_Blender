AI_ANIME_FFMPEG_BIN=
AI_ANIME_FFPROBE_BIN=
AI_ANIME_BLENDER_BIN=

# UE5 is intentionally left manual.
AI_ANIME_UNREAL_CMD_TEMPLATE=

# Third-party roots
AI_ANIME_THIRD_PARTY_ROOT=D:/AI_Anime_Project/ThirdParty
AI_ANIME_MODELS_ROOT=D:/AI_Anime_Project/Models
AI_ANIME_ENVS_ROOT=D:/AI_Anime_Project/.envs

# Replace {repo_root} with the actual checked-out tool root if you do not use the bootstrap script.
AI_ANIME_COSYVOICE_CMD_TEMPLATE=micromamba run -n ai-anime-cosyvoice python {repo_root}/cli.py --text {text} --ref-audio {ref_audio} --ref-text {ref_text} --output {output}
AI_ANIME_WHISPERX_CMD_TEMPLATE=micromamba run -n ai-anime-whisperx python {repo_root}/run_whisperx.py --audio {audio} --output {output} --text {text}
AI_ANIME_HUNYUAN3D_CMD_TEMPLATE=micromamba run -n ai-anime-hunyuan3d python {repo_root}/infer.py --prompt {prompt} --negative_prompt {negative_prompt} --ref_image {ref_image} --output {output} --seed {seed}
